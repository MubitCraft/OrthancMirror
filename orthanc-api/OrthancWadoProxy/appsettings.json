{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Orthanc": {
    "BaseUrl": "http://localhost:8042/"
  },
  "OrthancDicom": {
    "Host": "127.0.0.1",
    "Port": 4242,
    "CallingAet": "WADOPROXY",
    "CalledAet": "ORTHANC"
  },
  "WsiDicomizer": {
    "ExecutablePath": "",
    "GeneratePyramid": true,
    "SmoothPyramid": true,
    "Threads": 0,
    "TimeoutHours": 72
  },
  "ChunkedUpload": {
    "TempDirectory": "",
    "MaxFileBytes": 42949672960,
    "MaxOrthancCStoreBytes": 134217728,
    "MaxChunkBytes": 10485760,
    "MaxActiveUploads": 8,
    "IncompleteUploadHours": 24,
    "CompletedUploadRetentionHours": 72
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  },
  "AllowedHosts": "*"
}
