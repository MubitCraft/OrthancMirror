<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
	<security>
	  <authentication>
		<anonymousAuthentication enabled="false" />
		<windowsAuthentication enabled="true" />
	  </authentication>
	</security>
	<rewrite>
	  <rules>
		<rule name="Orthanc DICOMweb reverse proxy" stopProcessing="true">
		  <match url="^dicom-web(?:/(.*))?$" />
		  <action type="Rewrite" url="http://127.0.0.1:8042/dicom-web/{R:1}" appendQueryString="true" />
		</rule>
	  </rules>
	</rewrite>
	<aspNetCore processPath="dotnet" arguments=".\OrthancWadoProxy.dll" stdoutLogEnabled="false" hostingModel="inprocess" />
  </system.webServer>
</configuration>
